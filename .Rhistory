add_raster_source(
id = "raster_source",
tiles = raster_to_tiles(raster_low),  # Convert stars to tiles
tileSize = 256
) %>%
add_raster_layer(
id = "raster_layer",
source = "raster_source",
max_zoom = 11,              # Hide when zooming in past 11
raster_opacity = 0.8
)
