# Time-expanded Dijkstra for transit routing
dijkstra_transit <- function(starting_node, max_time = 46) {
# Set up distance tracking with named vectors for O(1) lookups
distances <- setNames(rep(Inf, length(all_nodes)), all_nodes)
distances[starting_node] <- 0
visited <- setNames(rep(FALSE, length(all_nodes)), all_nodes)
# Track unvisited nodes
unvisited_nodes <- all_nodes
while (length(unvisited_nodes) > 0) {
# Find closest unvisited node
unvisited_distances <- distances[unvisited_nodes]
# Early termination if all remaining distances > max_time
if(all(unvisited_distances > max_time)) break
min_idx <- which.min(unvisited_distances)
current_node <- unvisited_nodes[min_idx]
current_distance <- unvisited_distances[min_idx]
# Early termination if closest node exceeds max_time
if(current_distance > max_time) break
# Remove from unvisited and mark as visited
unvisited_nodes <- unvisited_nodes[-min_idx]
visited[current_node] <- TRUE
# Get reachable nodes from adjacency list
reachable_edges <- adjacency_list[[current_node]]
if(!is.null(reachable_edges) && nrow(reachable_edges) > 0) {
neighbor_distances <- distances[reachable_edges$to]
new_distances <- reachable_edges$weight + current_distance
update_mask <- new_distances < neighbor_distances & !is.na(neighbor_distances)
if(any(update_mask)) {
distances[reachable_edges$to[update_mask]] <- new_distances[update_mask]
}
}
}
# Return results for visited nodes within time limit
visited_nodes <- all_nodes[visited & distances <= max_time]
result <- data.table(
node = visited_nodes,
distance = distances[visited_nodes]
)
return(result)
}
result <- dijkstra_transit(sample_start)
